{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}, "_meta": {"title": "Diffusion Ref2VA INT8"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}, "_meta": {"title": "CLIP Qwen3VL"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}, "_meta": {"title": "VAE video"}},
  "4": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}, "_meta": {"title": "VAE audio"}},
  "5": {"class_type": "LoadImage", "inputs": {"image": "{{INPUT_IMAGE}}"}, "_meta": {"title": "Foto reference"}},
  "6": {"class_type": "MiniMaxH3ReferenceToVideo", "inputs": {"prompt": "{{PROMPT}}", "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "length": "{{LENGTH}}", "ref_image_size": "match", "clip": ["2", 0], "vae": ["3", 0], "audio_vae": ["4", 0], "ref_images.ref_image_0": ["5", 0]}, "_meta": {"title": "H3 Reference to Video"}},
  "7": {"class_type": "RandomNoise", "inputs": {"noise_seed": "{{SEED}}"}, "_meta": {"title": "Noise"}},
  "8": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}, "_meta": {"title": "Sampler euler"}},
  "9": {"class_type": "BasicScheduler", "inputs": {"scheduler": "simple", "steps": 4, "denoise": 1.0, "model": ["14", 0]}, "_meta": {"title": "Scheduler 4-step simple"}},
  "10": {"class_type": "BasicGuider", "inputs": {"model": ["14", 0], "conditioning": ["6", 0]}, "_meta": {"title": "Guider"}},
  "11": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["7", 0], "guider": ["10", 0], "sampler": ["8", 0], "sigmas": ["9", 0], "latent_image": ["6", 1]}, "_meta": {"title": "Sampler custom"}},
  "12": {"class_type": "LoraLoaderModelOnly", "inputs": {"lora_name": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors", "strength_model": 1.0, "model": ["1", 0]}, "_meta": {"title": "Turbo LoRA 4-step"}},
  "13": {"class_type": "Ref2VAVSAGatePatch", "inputs": {"gate_file": "fasth3_vsa_gate.safetensors", "sparsity": 0.75, "model": ["12", 0]}, "_meta": {"title": "VSA gate patch 75%"}},
  "14": {"class_type": "MiniMaxH3SigmaShift", "inputs": {"shift_video": 12, "shift_audio": 3, "model": ["13", 0]}, "_meta": {"title": "Sigma shift 12/3"}},
  "15": {"class_type": "VAEDecode", "inputs": {"samples": ["11", 0], "vae": ["3", 0]}, "_meta": {"title": "Decode video"}},
  "16": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["11", 0], "vae": ["4", 0]}, "_meta": {"title": "Decode audio"}},
  "17": {"class_type": "CreateVideo", "inputs": {"fps": 24, "images": ["15", 0], "audio": ["16", 0]}, "_meta": {"title": "Create video 24fps"}},
  "18": {"class_type": "SaveVideo", "inputs": {"filename_prefix": "journey/{{JOB_ID}}", "video": ["17", 0]}, "_meta": {"title": "Save video"}}
}
