[Unit]
Description=Hermes GPU Manager (CPU-only LLM/MEDIA orchestrator)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=matteo
Group=matteo
# Chiavi controllo/app via credential root-only (l'agente non le legge):
# manager.key = controllo pieno (laya), app.key = ruolo app.
LoadCredential=manager.key:/etc/hermes/keys/manager.key
LoadCredential=app.key:/etc/hermes/keys/app.key
WorkingDirectory=/opt/hermes/gpu-manager
ExecStart=/opt/hermes/gpu-manager/venv/bin/python /opt/hermes/gpu-manager/manager.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
