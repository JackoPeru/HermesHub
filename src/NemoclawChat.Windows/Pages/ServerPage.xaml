<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NemoclawChat_Windows.Pages.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <Grid Padding="44,36">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13">
                        <FontIcon FontSize="19" Glyph="&#xE968;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Style="{StaticResource PageTitleStyle}"
                            Text="Hermes Server" />
                        <TextBlock
                            Style="{StaticResource PageSubtitleStyle}"
                            Text="Dashboard Hermes Agent API: health, detailed health, models e capabilities." />
                    </StackPanel>
                </StackPanel>

                <!-- Hero stato + numeri live (come Android): colpo d'occhio, dettagli dietro tap. -->
                <Border
                    x:Name="HeroCard"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="HeroDot"
                            Width="12"
                            Height="12"
                            Fill="{StaticResource FaintTextBrush}"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                x:Name="HeroTitle"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Controllo stato…" />
                            <TextBlock x:Name="HeroSubtitle" Style="{StaticResource CaptionStyle}" Text="" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="BotValueText" Foreground="White" FontSize="26" FontWeight="Bold" Text="…" />
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" Text="BOT" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="in gestione" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="CronValueText" Foreground="White" FontSize="26" FontWeight="Bold" Text="…" />
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" Text="CRON" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="attive" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="ChatValueText" Foreground="White" FontSize="26" FontWeight="Bold" Text="…" />
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" Text="CHAT" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="salvate" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="GpuValueText" Foreground="White" FontSize="26" FontWeight="Bold" Text="…" />
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" Text="GPU" />
                                <TextBlock x:Name="GpuDetailText" Style="{StaticResource CaptionStyle}" Text="manager" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="BoardTimeText" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Text="" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="ReloadBoard_Click" Content="Ricarica" />
                    </StackPanel>
                </StackPanel>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="HERMES API" />
                        <TextBlock x:Name="GatewayText" Foreground="White" TextWrapping="Wrap" />
                        <Expander Header="Dettagli" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="GatewayFullText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="GatewayDetailText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="MODELLO" />
                        <TextBlock x:Name="ModelText" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock x:Name="ProviderText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="INFERENZA LATO SERVER" />
                        <TextBlock x:Name="InferenceText" Foreground="White" TextWrapping="Wrap" />
                        <Expander Header="Dettagli" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="InferenceFullText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="VideoPathText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="Il client parla a Hermes API, non direttamente al runtime modello." TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                        <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="SICUREZZA" />
                        <TextBlock x:Name="PolicyText" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="API key Hermes lato app: Bearer configurato dall'utente. Esposizione consigliata solo LAN/Tailscale." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="AZIONI HERMES" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Style="{StaticResource TextButtonStyle}"
                            Click="TestGateway_Click"
                            Content="Test Hermes" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="Refresh_Click" Content="Ricarica settings" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="ShowApiContract_Click" Content="Mostra API" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ContractText"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Contratto API nascosto. Premi Mostra API."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="CAPABILITIES HERMES" />
                    <TextBlock x:Name="GatewayWsText" Foreground="White" TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="Lettura reale di /v1/capabilities e /v1/models usando solo URL Hermes."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PasswordBox
                            x:Name="GatewaySecretBox"
                            Width="1"
                            Height="1"
                            Visibility="Collapsed" />
                        <Button
                            Style="{StaticResource TextButtonStyle}"
                            Click="TestGatewayWs_Click"
                            Content="Leggi capabilities" />
                    </StackPanel>
                    <TextBlock
                        x:Name="GatewayWsResultText"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Nessun controllo capabilities eseguito."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="DIAGNOSTICA GATEWAY" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Controlla health, key, modelli, capabilities, media, video library, memoria e hub state." TextWrapping="Wrap" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="RunDiagnostics_Click" Content="Esegui diagnostica" />
                    <StackPanel x:Name="DiagnosticsPanel" Spacing="10" />
                </StackPanel>

                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="CENTRO CONTROLLO SERVER" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Azioni tipizzate e allowlist: Hermes, gateway, llama.cpp e Tailscale. Stop e restart richiedono conferma." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ServiceBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="hermes" /><ComboBoxItem Content="gateway" /><ComboBoxItem Content="llama" /><ComboBoxItem Content="tailscale" /></ComboBox>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="StartService_Click" Content="Avvia" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="StopService_Click" Content="Ferma" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="RestartService_Click" Content="Riavvia" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="RefreshControl_Click" Content="Aggiorna" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource TextButtonStyle}" Click="Maintenance_Click" Tag="update" Content="Aggiorna server" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="Maintenance_Click" Tag="rollback" Content="Rollback" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="Maintenance_Click" Tag="backup" Content="Backup" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="Maintenance_Click" Tag="restore" Content="Ripristina" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="Maintenance_Click" Tag="diagnostic" Content="Pacchetto diagnostico" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="IntegrationTests_Click" Content="Test STT/TTS/media/tool" />
                    </StackPanel>
                    <TextBox x:Name="LogFilterBox" Header="Filtro log live" TextChanged="LogFilterBox_TextChanged" />
                    <TextBox x:Name="ControlOutputBox" Header="Servizi · coda · run · GPU · log" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="340" FontFamily="Consolas" />
                    <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="TELEFONO REMOTO" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Accoda comandi phone_use (tap, swipe, text, key, open_app, list_apps, dump_tree). Il telefono li esegue solo se armato." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="PhoneKindBox" Width="150" SelectedIndex="0"><ComboBoxItem Content="tap" /><ComboBoxItem Content="swipe" /><ComboBoxItem Content="text" /><ComboBoxItem Content="key" /><ComboBoxItem Content="open_app" /><ComboBoxItem Content="list_apps" /><ComboBoxItem Content="dump_tree" /></ComboBox>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="PhoneSend_Click" Content="Accoda" />
                        <Button Style="{StaticResource TextButtonStyle}" Click="PhoneResult_Click" Content="Leggi risultato" />
                    </StackPanel>
                    <TextBox x:Name="PhoneParamsBox" Header="Payload JSON (es. {&quot;x&quot;:500,&quot;y&quot;:800})" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" FontFamily="Consolas" />
                    <TextBox x:Name="PhoneOutputBox" Header="Coda telefono · id e risultati" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" FontFamily="Consolas" />
                    <TextBlock x:Name="CompatibilityWarningText" Foreground="#FFFFB86B" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
