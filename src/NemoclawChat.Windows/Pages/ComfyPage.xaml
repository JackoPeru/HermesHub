<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NemoclawChat_Windows.Pages.ComfyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer>
            <Grid Padding="44,36" RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13">
                        <FontIcon FontSize="19" Glyph="&#xE768;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Comfy" />
                        <TextBlock MaxWidth="920" Style="{StaticResource PageSubtitleStyle}" Text="Cosa sta facendo la GPU: stato, lavoro e avanzamento live." />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="16">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource FormSectionHeaderStyle}"
                                VerticalAlignment="Center"
                                Text="STATO GPU" />
                            <Button
                                Grid.Column="1"
                                Click="Refresh_Click"
                                Content="Aggiorna"
                                Style="{StaticResource TextButtonStyle}" />
                        </Grid>
                        <TextBlock
                            x:Name="StateText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Leggo lo stato dal manager…" />
                        <ProgressBar
                            x:Name="ProgressBar"
                            Minimum="0"
                            Maximum="100"
                            IsIndeterminate="True" />
                        <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="QueueText" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="LlmText" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock
                            x:Name="PageStatusText"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="Aggiornato ogni 5 secondi mentre guardi." />
                </StackPanel>

                <StackPanel
                    x:Name="DirectPanel"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Spacing="16">
                    <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="COMFY DIRETTO" />
                        <TextBlock x:Name="DirectQueueText" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock FontWeight="SemiBold" Foreground="#FFFF7B8E" Text="Errori Comfy" />
                        <TextBlock
                            x:Name="DirectErrorText"
                            Foreground="#FFFF7B8E"
                            MaxLines="8"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="10">
                    <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="CHAT LAYA" />
                    <TextBlock
                        Foreground="{StaticResource MutedTextBrush}"
                        TextWrapping="Wrap"
                        Text="Chiedi in linguaggio naturale: &quot;metti l'LLM ready&quot;, &quot;attiva comfy&quot;, &quot;metti in auto&quot;, &quot;come sta?&quot;." />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="LayaInput"
                            KeyDown="LayaInput_KeyDown"
                            PlaceholderText="Chiedi a laya…" />
                        <Button
                            x:Name="LayaSendButton"
                            Grid.Column="1"
                            Click="LayaSend_Click"
                            Content="Invia"
                            Style="{StaticResource TextButtonStyle}" />
                    </Grid>
                    <TextBlock
                        x:Name="LayaReplyText"
                        Foreground="White"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
