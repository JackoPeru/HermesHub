<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NemoclawChat_Windows.Pages.ComfyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer>
            <Grid Padding="44,36" RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13">
                        <FontIcon FontSize="19" Glyph="&#xE768;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Comfy" />
                        <TextBlock MaxWidth="920" Style="{StaticResource PageSubtitleStyle}" Text="Cosa sta facendo la GPU: stato, lavoro e avanzamento live." />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="16">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource FormSectionHeaderStyle}"
                                VerticalAlignment="Center"
                                Text="STATO GPU" />
                            <Button
                                Grid.Column="1"
                                Click="Refresh_Click"
                                Content="Aggiorna"
                                Style="{StaticResource TextButtonStyle}" />
                        </Grid>
                        <TextBlock
                            x:Name="StateText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Leggo lo stato dal manager…" />
                        <ProgressBar
                            x:Name="ProgressBar"
                            Minimum="0"
                            Maximum="100"
                            IsIndeterminate="True" />
                        <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="QueueText" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="LlmText" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock
                            x:Name="PageStatusText"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="Aggiornato ogni 5 secondi mentre guardi." />
                </StackPanel>

                <StackPanel
                    x:Name="DirectPanel"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Spacing="16">
                    <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="COMFY DIRETTO" />
                        <TextBlock x:Name="DirectQueueText" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock FontWeight="SemiBold" Foreground="#FFFF7B8E" Text="Errori Comfy" />
                        <TextBlock
                            x:Name="DirectErrorText"
                            Foreground="#FFFF7B8E"
                            MaxLines="8"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    x:Name="WorkflowPanel"
                    Grid.Row="3"
                    Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource FormSectionHeaderStyle}"
                            VerticalAlignment="Center"
                            Text="WORKFLOW LIVE" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="WorkflowRefresh_Click"
                                Content="Ricarica"
                                Style="{StaticResource TextButtonStyle}" />
                            <Button
                                Click="WorkflowOpenBrowser_Click"
                                Content="Apri nel browser"
                                Style="{StaticResource TextButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <Border
                        MinHeight="520"
                        Height="560"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="#FF101014"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <WebView2
                                x:Name="ComfyWebView"
                                NavigationCompleted="ComfyWebView_NavigationCompleted"
                                Visibility="Visible" />
                            <TextBlock
                                x:Name="WebViewFallbackText"
                                Foreground="{StaticResource MutedTextBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Margin="24,0"
                                Text="Comfy non è raggiungibile: la vista workflow serve solo mentre Comfy genera. I job dell'agente restano visibili sotto in JOB AGENTE."
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <TextBlock
                        x:Name="WorkflowJobText"
                        Foreground="White"
                        TextWrapping="Wrap"
                        Text="Job attivo: —" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="CancelJobButton"
                            Click="CancelJob_Click"
                            Content="Annulla job"
                            IsEnabled="False"
                            Style="{StaticResource TextButtonStyle}" />
                        <Button
                            x:Name="EditQueuedButton"
                            Click="EditQueued_Click"
                            Content="Modifica workflow in coda"
                            IsEnabled="False"
                            Style="{StaticResource TextButtonStyle}" />
                        <Button
                            x:Name="InterruptResubmitButton"
                            Click="InterruptResubmit_Click"
                            Content="Interrompi e risottometti"
                            IsEnabled="False"
                            Style="{StaticResource TextButtonStyle}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="WorkflowActionText"
                        Foreground="{StaticResource MutedTextBrush}"
                        TextWrapping="Wrap"
                        Text="Intervenire qui non cambia la modalità del manager: atterra sempre in AUTO." />
                </StackPanel>

                <StackPanel Grid.Row="4" Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="JobsHeaderText"
                            Style="{StaticResource FormSectionHeaderStyle}"
                            VerticalAlignment="Center"
                            Text="JOB AGENTE" />
                        <Button
                            Grid.Column="1"
                            Click="Refresh_Click"
                            Content="Aggiorna"
                            Style="{StaticResource TextButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Foreground="{StaticResource MutedTextBrush}"
                        TextWrapping="Wrap"
                        Text="Tutti i job che l'agente fa in autonomia, anche quando Comfy è fermo: arrivano dal manager, non dalla vista workflow." />
                    <ListView
                        x:Name="JobsList"
                        MaxHeight="300"
                        SelectionChanged="JobsList_SelectionChanged"
                        SelectionMode="Single" />
                    <TextBlock
                        x:Name="JobDetailText"
                        Foreground="{StaticResource MutedTextBrush}"
                        TextWrapping="Wrap"
                        Text="Seleziona un job per i dettagli." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="OpenOutputButton"
                            Click="OpenOutput_Click"
                            Content="Apri output"
                            IsEnabled="False"
                            Style="{StaticResource TextButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="5" Spacing="10">
                    <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="CHAT LAYA" />
                    <TextBlock
                        Foreground="{StaticResource MutedTextBrush}"
                        TextWrapping="Wrap"
                        Text="Chiedi in linguaggio naturale: &quot;metti l'LLM ready&quot;, &quot;attiva comfy&quot;, &quot;metti in auto&quot;, &quot;come sta?&quot;." />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="LayaInput"
                            KeyDown="LayaInput_KeyDown"
                            PlaceholderText="Chiedi a laya…" />
                        <Button
                            x:Name="LayaSendButton"
                            Grid.Column="1"
                            Click="LayaSend_Click"
                            Content="Invia"
                            Style="{StaticResource TextButtonStyle}" />
                    </Grid>
                    <TextBlock
                        x:Name="LayaReplyText"
                        Foreground="White"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
