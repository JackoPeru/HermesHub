<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="NemoclawChat_Windows.Pages.ConversationManagerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppBackgroundBrush}">
  <ScrollViewer><StackPanel Padding="36" Spacing="22"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13"><FontIcon FontSize="19" Glyph="&#xE8F1;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="TitleText" Text="Gestione conversazione" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Metadati, export e rami della chat selezionata." Style="{StaticResource PageSubtitleStyle}" /></StackPanel></StackPanel>
    <StackPanel Spacing="16"><TextBox x:Name="FolderBox" Header="Cartella" /><TextBox x:Name="TagsBox" Header="Tag" /><TextBox x:Name="ProjectBox" Header="Progetto" /><TextBox x:Name="LinksBox" Header="Chat collegate (ID)" /><TextBox x:Name="SummaryBox" Header="Riepilogo" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="SaveMetadata_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Salva metadata" /><Button Click="Summarize_Click" Style="{StaticResource TextButtonStyle}" Content="Riassumi con Hermes" /><Button Click="DeleteSelected_Click" Style="{StaticResource DangerButtonStyle}" Content="Elimina selezionati" /></StackPanel></StackPanel>
       <StackPanel Spacing="16"><TextBlock Text="IMPORT / EXPORT" Style="{StaticResource FormSectionHeaderStyle}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ExportMarkdown_Click" Style="{StaticResource TextButtonStyle}" Content="Markdown" /><Button Click="ExportJson_Click" Style="{StaticResource TextButtonStyle}" Content="JSON" /><Button Click="ExportPdf_Click" Style="{StaticResource TextButtonStyle}" Content="PDF" /><Button Click="ExportHtml_Click" Style="{StaticResource TextButtonStyle}" Content="HTML" /><Button Click="Import_Click" Style="{StaticResource TextButtonStyle}" Content="Importa" /></StackPanel></StackPanel>
   <TextBlock Text="MESSAGGI" Style="{StaticResource FormSectionHeaderStyle}" /><StackPanel x:Name="MessagesPanel" Spacing="16" /><TextBlock Text="RAMI E RISPOSTE ALTERNATIVE" Style="{StaticResource FormSectionHeaderStyle}" /><StackPanel x:Name="BranchesPanel" Spacing="16" /><TextBlock x:Name="StatusText" Text="Pronto." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
 </StackPanel></ScrollViewer>
</Page>
