<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NemoclawChat_Windows.Pages.CharactersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer>
            <Grid Padding="44,36" RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13">
                            <FontIcon FontSize="19" Glyph="&#xE77B;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Personaggi" />
                            <TextBlock
                                MaxWidth="920"
                                Style="{StaticResource PageSubtitleStyle}"
                                Text="Identità persistenti per i video H3, tutte locali." />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource TextButtonStyle}" Click="Refresh_Click" Content="Aggiorna" />
                        <Button
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="New_Click"
                            Content="+ Nuovo" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    x:Name="StatusText"
                    Grid.Row="1"
                    Style="{StaticResource CaptionStyle}"
                    Text="Carico personaggi…"
                    TextWrapping="Wrap" />

                <!-- Lista personaggi -->
                <StackPanel
                    x:Name="ListPanel"
                    Grid.Row="2"
                    Spacing="12">
                    <StackPanel x:Name="CardsPanel" Spacing="12" />
                </StackPanel>

                <!-- Wizard creazione -->
                <StackPanel
                    x:Name="WizardPanel"
                    Grid.Row="3"
                    Spacing="16"
                    Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource TextButtonStyle}" Click="WizardCancel_Click" Content="Indietro" />
                            <TextBlock
                                x:Name="WizardTitleText"
                                VerticalAlignment="Center"
                                Style="{StaticResource FormSectionHeaderStyle}"
                                Text="CREA PERSONAGGIO · PASSO 1 DI 5" />
                        </StackPanel>

                        <StackPanel x:Name="WizardStep1Panel" Spacing="10">
                            <TextBlock FontWeight="SemiBold" Foreground="White" Text="Nome" />
                            <TextBox
                                x:Name="WizardNameBox"
                                PlaceholderText="Sofia" />
                            <Button
                                Style="{StaticResource TextButtonStyle}"
                                Click="WizardCreate_Click"
                                Content="Continua" />
                        </StackPanel>

                        <StackPanel x:Name="WizardStep2Panel" Spacing="10" Visibility="Collapsed">
                            <TextBlock FontWeight="SemiBold" Foreground="White" Text="Aggiungi foto" />
                            <TextBlock
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="Carica 20-80 foto della stessa persona (jpg/png/webp, max 15MB). Più angoli ed espressioni = identità migliore."
                                TextWrapping="Wrap" />
                            <Button Style="{StaticResource TextButtonStyle}" Click="PickPhotos_Click" Content="Scegli foto" />
                            <TextBlock
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="Puoi selezionare fino a 80 foto; l'invio avviene a gruppi di 10."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="WizardStep3Panel" Spacing="10" Visibility="Collapsed">
                            <TextBlock FontWeight="SemiBold" Foreground="White" Text="Analisi foto" />
                            <TextBlock
                                x:Name="WizardStateText"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="Stato: Bozza"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                x:Name="WizardProgress"
                                Minimum="0"
                                Maximum="100"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="WizardProgressText"
                                Foreground="{StaticResource MutedTextBrush}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="WizardCountsText"
                                Foreground="White"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="WizardAnalyze_Click" Content="Avvia analisi" />
                                <Button Style="{StaticResource TextButtonStyle}" Click="PickPhotos_Click" Content="Aggiungi foto" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="WizardStep5Panel" Spacing="10" Visibility="Collapsed">
                            <TextBlock
                                x:Name="WizardReadyText"
                                Style="{StaticResource FormSectionHeaderStyle}"
                                Text="PRONTO A CREARE"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="WizardQualityText"
                                Foreground="{StaticResource MutedTextBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="WizardTrainButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="WizardTrain_Click"
                                Content="Crea" />
                            <TextBlock
                                x:Name="WizardTrainWarning"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="Servono almeno 20 foto utilizzabili: aggiungine altre e riavvia l'analisi."
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource TextButtonStyle}" Click="PickPhotos_Click" Content="Aggiungi foto" />
                                <Button Style="{StaticResource TextButtonStyle}" Click="WizardGotoDetail_Click" Content="Vai al dettaglio" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            x:Name="WizardMessageText"
                            Foreground="{StaticResource MutedTextBrush}"
                            TextWrapping="Wrap" />
                </StackPanel>

                <!-- Dettaglio personaggio -->
                <StackPanel
                    x:Name="DetailPanel"
                    Grid.Row="4"
                    Spacing="16"
                    Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource TextButtonStyle}" Click="DetailBack_Click" Content="Indietro" />
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="DetailNameText"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Personaggio" />
                                <TextBlock
                                    x:Name="DetailStatusText"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="Bozza" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="DetailJobPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock
                                x:Name="DetailJobTitleText"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Creazione in corso" />
                            <ProgressBar
                                x:Name="DetailJobProgress"
                                Minimum="0"
                                Maximum="100" />
                            <TextBlock
                                x:Name="DetailJobText"
                                Foreground="{StaticResource MutedTextBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DetailJobDetailText"
                                Foreground="{StaticResource MutedTextBrush}"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <Button Style="{StaticResource TextButtonStyle}" Click="DetailCancel_Click" Content="Annulla" />
                        </StackPanel>

                        <TextBlock
                            x:Name="DetailInfoText"
                            Foreground="White"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DetailIdentityText"
                            Foreground="{StaticResource MutedTextBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="DetailQualityText"
                            Foreground="{StaticResource MutedTextBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DetailVerdictsText"
                            Foreground="White"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="DetailUseButton"
                                Style="{StaticResource TextButtonStyle}"
                                Click="DetailUse_Click"
                                Content="Usa personaggio" />
                            <Button Style="{StaticResource TextButtonStyle}" x:Name="DetailAnalyzeButton" Click="DetailAnalyze_Click" Content="Analizza" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" x:Name="DetailTrainButton" Click="DetailTrain_Click" Content="Crea / Ripeti" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource TextButtonStyle}" Click="DetailRename_Click" Content="Rinomina" />
                            <Button Style="{StaticResource TextButtonStyle}" Click="DetailExport_Click" Content="Esporta" />
                            <Button Style="{StaticResource DangerButtonStyle}" x:Name="DetailDeleteButton" Click="DetailDelete_Click" Content="Elimina" />
                        </StackPanel>

                        <StackPanel x:Name="DetailGeneratePanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock FontWeight="SemiBold" Foreground="White" Text="Genera video" TextWrapping="Wrap" />
                            <TextBox
                                x:Name="GeneratePromptBox"
                                AcceptsReturn="True"
                                MinHeight="80"
                                PlaceholderText="walking through Tokyo at night…"
                                TextWrapping="Wrap" />
                            <ComboBox x:Name="GenerateModeBox" Header="Identità" SelectedIndex="0">
                                <ComboBoxItem Content="Auto" Tag="auto" />
                                <ComboBoxItem Content="Character LoRA" Tag="lora" />
                                <ComboBoxItem Content="Reference" Tag="reference" />
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ComboBox x:Name="GenerateDurationBox" Header="Durata" SelectedIndex="1">
                                    <ComboBoxItem Content="3s" Tag="3" />
                                    <ComboBoxItem Content="5s" Tag="5" />
                                    <ComboBoxItem Content="10s" Tag="10" />
                                </ComboBox>
                                <ComboBox x:Name="GenerateAspectBox" Header="Formato" SelectedIndex="0">
                                    <ComboBoxItem Content="16:9" Tag="16:9" />
                                    <ComboBoxItem Content="9:16" Tag="9:16" />
                                    <ComboBoxItem Content="1:1" Tag="1:1" />
                                </ComboBox>
                                <TextBox
                                    x:Name="GenerateSeedBox"
                                    Header="Seed"
                                    Text="42"
                                    Width="140" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="GenerateStart_Click"
                                    Content="Genera" />
                                <Button Style="{StaticResource TextButtonStyle}" Click="GenerateClose_Click" Content="Chiudi" />
                            </StackPanel>
                            <TextBlock
                                x:Name="GenerateResultText"
                                Foreground="{StaticResource MutedTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            x:Name="DetailMessageText"
                            Foreground="{StaticResource MutedTextBrush}"
                            TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
