<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NemoclawChat_Windows.Pages.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="44,36" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13">
                <FontIcon FontSize="19" Glyph="&#xE8B7;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Style="{StaticResource PageTitleStyle}"
                    Text="Archivio" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="Ricerca locale per chat, progetti e task recenti salvati davvero sul dispositivo." />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                Header="Cerca"
                PlaceholderText="Cerca chat, progetto, server, task..."
                TextChanged="SearchBox_TextChanged" />
            <ComboBox
                x:Name="FilterBox"
                Grid.Column="1"
                Header="Filtro"
                SelectionChanged="FilterBox_SelectionChanged"
                SelectedIndex="0">
                <ComboBoxItem Content="Tutto" />
                <ComboBoxItem Content="Chat" />
                <ComboBoxItem Content="Progetto" />
                <ComboBoxItem Content="Task" />
                <ComboBoxItem Content="Server" />
            </ComboBox>
            <Button
                Grid.Column="2"
                Margin="0,28,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="NewChat_Click"
                Content="Nuova chat" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultsPanel" Spacing="16" />
            </ScrollViewer>

            <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="DETTAGLIO" />
                <TextBlock
                    x:Name="DetailTitleText"
                    Style="{StaticResource SectionTitleStyle}"
                    Text="Seleziona elemento" />
                <TextBlock
                    x:Name="DetailBodyText"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="Qui vedi dettagli e prompt dell'elemento selezionato."
                    TextWrapping="Wrap" />
                <Button
                    x:Name="OpenButton"
                    Style="{StaticResource TextButtonStyle}"
                    Click="OpenSelected_Click"
                    Content="Apri"
                    IsEnabled="False" />
                <Button
                    x:Name="PinButton"
                    Style="{StaticResource TextButtonStyle}"
                    Click="PinSelected_Click"
                    Content="Segna progetto"
                    IsEnabled="False" />
                <Button
                    x:Name="DeleteButton"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteSelected_Click"
                    Content="Elimina"
                    IsEnabled="False" />
                <Button Style="{StaticResource TextButtonStyle}" x:Name="ManageButton" Click="ManageSelected_Click" Content="Gestisci" IsEnabled="False" />
                <Button
                    Style="{StaticResource TextButtonStyle}"
                    Click="UploadServer_Click"
                    Content="Carica server" />
                <Button
                    Style="{StaticResource TextButtonStyle}"
                    Click="DownloadServer_Click"
                    Content="Scarica server" />
                <TextBlock
                    x:Name="StatusText"
                    Style="{StaticResource CaptionStyle}"
                    Text="Pronto."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
