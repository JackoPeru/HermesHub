<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NemoclawChat_Windows.Pages.CronPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <Grid Padding="44,36">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Left" Spacing="22">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13">
                            <FontIcon FontSize="19" Glyph="&#xE7C1;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Automation Studio" />
                            <TextBlock
                                Style="{StaticResource PageSubtitleStyle}"
                                Text="Crea, modifica, prova e controlla automazioni Hermes sul gateway." />
                        </StackPanel>
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        MinWidth="110"
                        Click="Refresh_Click"
                        Style="{StaticResource TextButtonStyle}"
                        Content="Aggiorna" />
                </Grid>

                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="EditorTitle" Style="{StaticResource SectionTitleStyle}" Text="Nuova automazione" />
                            <Button Grid.Column="1" Click="ClearEditor_Click" Style="{StaticResource TextButtonStyle}" Content="Nuova" />
                        </Grid>
                        <TextBox x:Name="NameBox" Header="Nome" MaxLength="120" />
                        <ComboBox x:Name="BotProfileBox" Header="Profilo routine" SelectionChanged="BotProfileBox_SelectionChanged" />
                        <TextBlock x:Name="BotScopeHint" Style="{StaticResource CaptionStyle}" Text="Routine globali sul profilo predefinito." TextWrapping="Wrap" />
                        <TextBox x:Name="TaskPromptBox" Header="Attività" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxLength="12000" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="FrequencyBox" Header="Frequenza" SelectionChanged="FrequencyBox_SelectionChanged" SelectedIndex="1">
                                <ComboBoxItem Content="Ogni ora" /><ComboBoxItem Content="Giornaliera" /><ComboBoxItem Content="Settimanale" /><ComboBoxItem Content="Cron avanzato" />
                            </ComboBox>
                            <TextBox x:Name="TimeBox" Grid.Column="1" Header="Ora" Text="08:00" />
                            <TextBox x:Name="DaysBox" Grid.Column="2" Header="Giorni cron" PlaceholderText="1,2,3,4,5" Text="1,2,3,4,5" />
                        </Grid>
                        <TextBox x:Name="AdvancedCronBox" Header="Espressione cron avanzata" PlaceholderText="0 8 * * 1-5" Visibility="Collapsed" />
                        <TextBlock x:Name="SchedulePreviewText" Style="{StaticResource CaptionStyle}" Text="Prossime esecuzioni: ogni giorno alle 08:00" TextWrapping="Wrap" />
                        <TextBox x:Name="ConditionBox" Header="Condizione opzionale" PlaceholderText="Esegui solo se temperatura server &gt; 85 C" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="DeliverBox" Header="Destinazione" Text="local" />
                            <NumberBox x:Name="TimeoutBox" Grid.Column="1" Header="Timeout secondi" Value="900" Minimum="10" Maximum="86400" />
                            <NumberBox x:Name="RetryBox" Grid.Column="2" Header="Retry" Value="0" Minimum="0" Maximum="10" />
                        </Grid>
                        <TextBox x:Name="NotificationBox" Header="Modello notifica" PlaceholderText="Titolo e messaggio da inviare al termine" />
                        <TextBox x:Name="ProjectBox" Header="Progetto associato" />
                        <TextBox x:Name="DependenciesBox" Header="Dipendenze" PlaceholderText="ID job separati da virgola" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="SaveEditor_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Salva" />
                            <Button Click="TestEditor_Click" Style="{StaticResource TextButtonStyle}" Content="Prova senza salvare" />
                            <Button Click="DuplicateEditor_Click" Style="{StaticResource TextButtonStyle}" Content="Duplica" />
                        </StackPanel>
                </StackPanel>

                <StackPanel Spacing="16">
                    <TextBlock
                            x:Name="StatusText"
                            Style="{StaticResource SectionTitleStyle}"
                            Text="Caricamento cron..." />
                        <TextBlock
                            Style="{StaticResource CaptionStyle}"
                            Text="Fonte: API Hermes jobs. Scegli Globale / default oppure un profilo bot; le routine bot usano /p/{profilo}/api/jobs solo con multiplexing dichiarato."
                            TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="CronPanel" Spacing="16" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
