<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="NemoclawChat_Windows.Pages.ContinuityPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppBackgroundBrush}">
   <ScrollViewer><StackPanel Padding="36" Spacing="22">
     <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
       <Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13">
         <FontIcon FontSize="19" Glyph="&#xE8C8;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
       </Border>
       <StackPanel VerticalAlignment="Center" Spacing="2">
         <TextBlock Style="{StaticResource PageTitleStyle}" Text="Continuità dispositivi" />
         <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Riprendi chat, trasferisci voce, clipboard e file tra Windows e Android. Stato e conflitti restano visibili." TextWrapping="Wrap" />
       </StackPanel>
     </StackPanel>
    <StackPanel Spacing="16"><TextBlock Text="QUESTO DISPOSITIVO" Style="{StaticResource FormSectionHeaderStyle}" /><TextBlock x:Name="DeviceText" Style="{StaticResource CaptionStyle}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="PublishPresence_Click" Style="{StaticResource TextButtonStyle}" Content="Pubblica presenza" /><Button Click="ResumeLatest_Click" Style="{StaticResource TextButtonStyle}" Content="Riprendi chat attiva" /><Button Click="TransferVoice_Click" Style="{StaticResource TextButtonStyle}" Content="Trasferisci chiamata qui" /><Button Click="FlushQueue_Click" Style="{StaticResource TextButtonStyle}" Content="Sincronizza coda offline" /></StackPanel><TextBlock x:Name="SyncText" Foreground="{StaticResource AccentGreenBrush}" /></StackPanel>
    <StackPanel Spacing="16"><TextBlock Text="CLIPBOARD E FILE" Style="{StaticResource FormSectionHeaderStyle}" /><TextBox x:Name="ClipboardBox" Header="Clipboard condivisa" AcceptsReturn="True" MinHeight="80" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="SendClipboard_Click" Style="{StaticResource TextButtonStyle}" Content="Invia clipboard" /><Button Click="ReceiveClipboard_Click" Style="{StaticResource TextButtonStyle}" Content="Ricevi clipboard" /><Button Click="SendFile_Click" Style="{StaticResource TextButtonStyle}" Content="Invia file al telefono" /></StackPanel></StackPanel>
       <TextBlock Text="DISPOSITIVI E HANDOFF" Style="{StaticResource FormSectionHeaderStyle}" /><StackPanel x:Name="ItemsPanel" Spacing="16" /><TextBlock Text="CONFLITTI" Style="{StaticResource FormSectionHeaderStyle}" /><StackPanel x:Name="ConflictsPanel" Spacing="16" /><TextBlock x:Name="StatusText" Style="{StaticResource CaptionStyle}" />
 </StackPanel></ScrollViewer>
</Page>
