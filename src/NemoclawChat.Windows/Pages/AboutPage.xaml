<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NemoclawChat_Windows.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <Grid Padding="44,36">
            <StackPanel MaxWidth="860" Spacing="22">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13">
                        <FontIcon FontSize="19" Glyph="&#xE76C;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Profilo e app" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Info locale client. Nessun account cloud, nessun token provider nel client." />
                    </StackPanel>
                </StackPanel>

                <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="18">
                            <Image
                                Width="64"
                                Height="64"
                                Source="ms-appx:///Assets/ChatClawLogo.png"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="OPEN SOURCE" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Profilo locale per home-server Hermes Agent." />
                            <TextBlock x:Name="SettingsPathText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="VERSIONE" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="12">
                            <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="HERMES API" />
                            <TextBlock x:Name="GatewayText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="12">
                            <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="PRIVACY" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Chat e settings restano locali finche' non colleghi Hermes. API key Hermes salvata nel Credential Locker; segreti modello restano lato server." TextWrapping="Wrap" />
                        </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="12">
                            <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="MODALITA" />
                            <TextBlock x:Name="ModeText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                </Grid>

                <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource FormSectionHeaderStyle}" Text="AGGIORNAMENTI" />
                        <TextBlock
                            x:Name="UpdateStatusText"
                            Style="{StaticResource CaptionStyle}"
                            Text="Controlla GitHub Releases per nuove versioni."
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="UpdateSummaryText"
                            Foreground="White"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="UpdateDetailText"
                            Style="{StaticResource CaptionStyle}"
                            TextWrapping="Wrap" />
                        <ProgressBar
                            x:Name="UpdateProgressBar"
                            Height="8"
                            IsIndeterminate="False"
                            Maximum="100"
                            Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Click="CheckUpdates_Click"
                                Style="{StaticResource TextButtonStyle}"
                                Content="Controlla update" />
                            <Button
                                x:Name="DownloadUpdateButton"
                                Click="DownloadUpdate_Click"
                                Style="{StaticResource TextButtonStyle}"
                                Content="Scarica update"
                                IsEnabled="False"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="InstallUpdateButton"
                                Click="InstallUpdate_Click"
                                Style="{StaticResource TextButtonStyle}"
                                Content="Installa e riavvia"
                                IsEnabled="False"
                                Visibility="Collapsed" />
                        </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
