<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NemoclawChat_Windows.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="28" ColumnSpacing="20" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Border Width="44" Height="44" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#44F5A524" BorderThickness="1" CornerRadius="13">
                <FontIcon FontSize="19" Glyph="&#xE8F1;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Progetti" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Scegli un nome e, se serve, un system prompt personalizzato. Il resto e' automatico." />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Stretch" Click="NewProject_Click" Style="{StaticResource PrimaryButtonStyle}" Content="+ Nuovo progetto" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ProjectListPanel" Spacing="16" />
            </ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DashboardTitle" Style="{StaticResource SectionTitleStyle}" Text="Nuovo progetto" />
                        <TextBlock x:Name="ActiveBadge" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource AccentGreenBrush}" />
                    </Grid>
                    <TextBox x:Name="TitleBox" Header="Nome progetto" MaxLength="180" />
                    <TextBox
                        x:Name="SystemPromptBox"
                        Header="System prompt (facoltativo)"
                        PlaceholderText="Istruzioni personalizzate valide in tutte le chat del progetto"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MaxLength="20000"
                        MinHeight="180" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="SaveProject_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Salva" />
                        <Button x:Name="NewChatButton" Click="NewProjectChat_Click" Style="{StaticResource TextButtonStyle}" Content="Nuova chat nel progetto" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionStyle}" Text="Pronto." TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
