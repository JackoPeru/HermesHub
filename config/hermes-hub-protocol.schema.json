{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JackoPeru/HermesHub/blob/main/config/hermes-hub-protocol.schema.json",
  "title": "Hermes Hub Protocol v1",
  "description": "Canonical, forward-compatible wire contract shared by Hermes Hub clients and gateway.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "endpoints", "correlation_headers", "event_envelope", "error"],
  "properties": {
    "protocol_version": { "const": 1 },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "correlation_headers": { "$ref": "#/$defs/correlation_headers" },
    "event_envelope": { "$ref": "#/$defs/event_envelope" },
    "unknown_event_envelope": { "$ref": "#/$defs/event_envelope" },
    "error": { "$ref": "#/$defs/error" },
    "visual_blocks": { "$ref": "#/$defs/visual_blocks_contract" }
  },
  "$defs": {
    "wire_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request_id": { "$ref": "#/$defs/wire_id" },
    "correlation_id": { "$ref": "#/$defs/wire_id" },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "compatibility"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "path": { "type": "string", "pattern": "^/" },
        "compatibility": {
          "type": "string",
          "enum": ["required", "legacy-compatible", "capability-negotiated"]
        },
        "stream": { "type": "boolean", "default": false },
        "since": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "correlation_headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "correlation_id", "compatibility_request_id"],
      "properties": {
        "request_id": { "const": "X-Hermes-Request-Id" },
        "correlation_id": { "const": "X-Hermes-Correlation-Id" },
        "compatibility_request_id": { "const": "X-Request-Id" }
      }
    },
    "event_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "event_id",
        "sequence",
        "request_id",
        "correlation_id",
        "type",
        "payload",
        "source_type"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "event_id": { "$ref": "#/$defs/wire_id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "request_id": { "$ref": "#/$defs/request_id" },
        "correlation_id": { "$ref": "#/$defs/correlation_id" },
        "run_id": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/wire_id" }
          ]
        },
        "type": { "type": "string", "minLength": 1, "maxLength": 160 },
        "payload": {},
        "source_type": {
          "type": "string",
          "enum": ["hermes-agent", "hermes-gateway", "hermes-hub", "unknown"]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "code", "message", "request_id", "correlation_id"],
      "properties": {
        "protocol_version": { "const": 1 },
        "code": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "request_id": { "$ref": "#/$defs/request_id" },
        "correlation_id": { "$ref": "#/$defs/correlation_id" },
        "run_id": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/wire_id" }
          ]
        },
        "retryable": { "type": "boolean", "default": false },
        "details": { "type": "object", "additionalProperties": true }
      }
    },
    "visual_blocks_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fallback_field", "unknown_block_type"],
      "properties": {
        "version": { "const": 1 },
        "fallback_field": { "const": "output_text" },
        "unknown_block_type": { "const": "unknown_block" },
        "schema_ref": { "const": "config/visual-blocks.schema.json" }
      }
    }
  }
}
