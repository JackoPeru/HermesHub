{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JackoPeru/HermesHub/blob/main/config/jarvis-benchmark-manifest.schema.json",
  "title": "Hermes Jarvis synthetic observer benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer", "seed", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "renderer": { "const": "jarvis-synthetic-raster-v1" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "cases": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "split",
        "category",
        "mode",
        "goal",
        "question",
        "recent_context",
        "frames",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "split": { "enum": ["calibration", "holdout"] },
        "category": {
          "enum": [
            "normal_ignore",
            "relevant_change",
            "text_reading",
            "simple_question",
            "ambiguous",
            "possible_error",
            "complex_escalation"
          ]
        },
        "mode": { "enum": ["questions_only", "assistive", "proactive"] },
        "goal": { "type": "string", "maxLength": 240 },
        "question": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 240 }
          ]
        },
        "recent_context": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/frame" }
        },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestamp_ms", "scene", "variant", "caption", "accent", "state"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "timestamp_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "scene": {
          "enum": ["workbench", "label", "object", "connector", "assembly", "warning", "ambiguous"]
        },
        "variant": { "type": "integer", "minimum": 0, "maximum": 999 },
        "caption": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^[A-Z0-9 .:+-]*$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "state": { "enum": ["stable", "changed", "new", "ok", "error", "ambiguous"] }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "route",
        "risk",
        "should_speak_by_mode",
        "reply_terms_any",
        "reply_terms_all",
        "reply_terms_none",
        "required_frame_ids"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ignore", "respond_simple", "ask_user", "escalate", "urgent_candidate"]
          }
        },
        "route": { "enum": ["none", "fast", "reasoning"] },
        "risk": { "enum": ["none", "low", "medium", "high"] },
        "should_speak_by_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["questions_only", "assistive", "proactive"],
          "properties": {
            "questions_only": { "type": "boolean" },
            "assistive": { "type": "boolean" },
            "proactive": { "type": "boolean" }
          }
        },
        "reply_terms_any": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "reply_terms_all": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "reply_terms_none": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "required_frame_ids": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      }
    }
  }
}
